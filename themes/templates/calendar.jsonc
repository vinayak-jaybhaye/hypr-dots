{
  "clock": {
    "calendar": {
      "format": {
        "months": "<span color='#{{mauve}}'><b>{}</b></span>",
        "days": "<span color='#{{text}}'><b>{}</b></span>",
        "weeks": "<span color='#{{green}}'><b>W{}</b></span>",
        "weekdays": "<span color='#{{yellow}}'><b>{}</b></span>",
        "today": "<span color='#{{red}}'><b><u>{}</u></b></span>"
      }
    }
  }
}
