# Mako Notification Daemon Configuration

# Positioning and Layout
anchor=top-right
max-history=100
sort=-time

# Geometry
width=320
height=110
margin=12,12
padding=14

# Fonts and Content Styling
markup=1
format=<b>%s</b>\n%b

# Default behavior
default-timeout=6000
ignore-timeout=0

# Urgency Rules (Timeouts based on importance/urgency)
[urgency=low]
default-timeout=3000

[urgency=normal]
default-timeout=7000

[urgency=high]
default-timeout=0

# Do Not Disturb Mode Rules
[mode=do-not-disturb]
invisible=1
