{
  "modules-left": ["ext/workspaces", "hyprland/window"],

  "ext/workspaces": {
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "all-outputs": true,
    "active-only": false,
    "sort-by-id": true,
    "on-click": "activate",
    "format": "{name}"
  },

  "hyprland/window": {
    "format": "{}",
    "separate-outputs": true,
    "icon": true,
    "icon-size": 14,
    "max-length": 30
  }
}
