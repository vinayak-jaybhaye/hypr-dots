{
  "modules-right": [
    "group/connections",
    "group/audio",
    "group/hardware",
    "group/power-group",
    "group/sys-status"
  ],

  "group/connections": {
    "orientation": "inherit",
    "modules": ["network", "bluetooth"]
  },

  "group/audio": {
    "orientation": "inherit",
    "modules": ["pulseaudio", "pulseaudio#microphone", "backlight"]
  },

  "group/hardware": {
    "orientation": "inherit",
    "modules": ["cpu", "temperature", "memory"]
  },

  "group/power-group": {
    "orientation": "inherit",
    "modules": ["custom/power", "battery"]
  },

  "group/sys-status": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 160,
      "transition-left-to-right": false
    },
    "modules": ["custom/settings", "tray", "custom/power-btn"]
  }
}
