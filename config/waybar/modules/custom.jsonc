{
  "custom/power": {
    "exec": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/power.sh\"",
    "interval": 5
  },

  "custom/power-btn": {
    "format": "",
    "align": 0.5,
    "justify": "center",
    "tooltip-format": "Power menu",
    "on-click": "wlogout"
  },

  "custom/hyprsunset": {
    "exec": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/hyprsunset-status.sh\"",
    "return-type": "json",
    "tooltip": true,
    "align": 0.5,
    "justify": "center",
    "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/hyprsunset-toggle.sh\"",
    "signal": 2
  },

  "custom/dnd": {
    "exec": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/mako-dnd-status.sh\"",
    "return-type": "json",
    "format": "{text}",
    "align": 0.5,
    "justify": "center",
    "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/mako-dnd-toggle.sh\"",
    "tooltip": true,
    "signal": 3
  }
}
