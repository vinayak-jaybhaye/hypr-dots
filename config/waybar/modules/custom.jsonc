{
  "custom/power": {
    "exec": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/power.sh\"",
    "interval": 5
  },

  "custom/settings": {
    "format": "",
    "align": 0.5,
    "justify": "center",
    "tooltip-format": "Click to open Settings\nHover for tray and session controls",
    "on-click": "gtk-launch io.github.hyprdots.Settings"
  },

  "custom/power-btn": {
    "format": "",
    "align": 0.5,
    "justify": "center",
    "tooltip-format": "Power menu",
    "on-click": "wlogout"
  }
}
