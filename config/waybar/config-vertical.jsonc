{
  "name": "vertical",
  "layer": "top",
  "position": "left",
  "width": 50,
  "spacing": 4,
  "modules-left": [
    "ext/workspaces"
  ],
  "group/center-trio": {
    "orientation": "vertical"
  },
  "group/connections": {
    "orientation": "vertical"
  },
  "group/audio": {
    "orientation": "vertical"
  },
  "group/hardware": {
    "orientation": "vertical"
  },
  "group/power-group": {
    "orientation": "vertical",
    "modules": [
      "battery"
    ]
  },
  "group/sys-status": {
    "orientation": "vertical"
  },
  "clock": {
    "align": 0.5,
    "justify": "center",
    "format": "{:%H\n%M}"
  },
  "network": {
    "format": "󰈀",
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤮",
    "format-disabled": "󰤮",
    "align": 0.5,
    "justify": "center",
    "tooltip-format-wifi": "󰤨 {essid}\n󰒢 {signalStrength}%\n󰩟 {ipaddr}\n↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "tooltip-format-ethernet": "󰈀 {ifname}\n󰩟 {ipaddr}\n↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Network disconnected"
  },
  "bluetooth": {
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "align": 0.5,
    "justify": "center",
    "tooltip-format": "{controller_alias}\t{status}",
    "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "{icon}",
    "format-muted": "",
    "align": 0.5,
    "justify": "center",
    "format-icons": {
      "headphone": "",
      "hands-free": "󰋎",
      "headset": "󰋎"
    }
  },
  "pulseaudio#microphone": {
    "format-source": "",
    "format-source-muted": "",
    "align": 0.5,
    "justify": "center"
  },
  "battery": {
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "",
    "format-full": "󰁹",
    "align": 0.5,
    "justify": "center"
  },
  "backlight": {
    "format": "{icon}",
    "align": 0.5,
    "justify": "center",
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%"
  },
  "cpu": {
    "format": "",
    "align": 0.5,
    "justify": "center",
    "tooltip-format": "CPU: {usage}%"
  },
  "temperature": {
    "format": "",
    "format-critical": "🔥",
    "align": 0.5,
    "justify": "center",
    "tooltip-format": "Temp: {temperatureC}°C"
  },
  "memory": {
    "format": "",
    "align": 0.5,
    "justify": "center"
  },
  "idle_inhibitor": {
    "align": 0.5,
    "justify": "center"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 6
  },
  "include": [
    "modules/left.jsonc",
    "modules/center.jsonc",
    "modules/right.jsonc",
    "modules/system.jsonc",
    "modules/custom.jsonc"
  ]
}