{
  "name": "vertical",
  "layer": "top",
  "position": "left",
  "width": 50,
  "spacing": 2,
  "modules-left": [
    "ext/workspaces"
  ],
  "group/power-group": {
    "modules": [
      "battery"
    ]
  },
  "clock": {
    "align": 0.5,
    "justify": "center",
    "format": "{:%H\n%M}"
  },
  "network": {
    "format": "󰈀",
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤮",
    "format-disabled": "󰤮",
    "align": 0.5,
    "justify": "center"
  },
  "bluetooth": {
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "align": 0.5,
    "justify": "center",
    "tooltip-format": "{controller_alias}\t{status}",
    "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "{icon}",
    "format-muted": "",
    "align": 0.5,
    "justify": "center",
    "format-icons": {
      "headphone": "",
      "hands-free": "󰋎",
      "headset": "󰋎"
    }
  },
  "pulseaudio#microphone": {
    "format-source": "",
    "format-source-muted": "",
    "align": 0.5,
    "justify": "center"
  },
  "battery": {
    "format": "{icon}\n<small>{capacity}%</small>",
    "format-charging": "󰂄\n<small>{capacity}%</small>",
    "format-plugged": "\n<small>{capacity}%</small>",
    "format-full": "󰁹\n<small>{capacity}%</small>",
    "align": 0.5,
    "justify": "center"
  },
  "backlight": {
    "format": "{icon}",
    "align": 0.5,
    "justify": "center",
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%"
  },
  "cpu": {
    "format": "",
    "align": 0.5,
    "justify": "center",
    "tooltip-format": "CPU: {usage}%"
  },
  "temperature": {
    "format": "",
    "format-critical": "🔥",
    "align": 0.5,
    "justify": "center",
    "tooltip-format": "Temp: {temperatureC}°C"
  },
  "memory": {
    "format": "",
    "align": 0.5,
    "justify": "center"
  },
  "idle_inhibitor": {
    "align": 0.5,
    "justify": "center"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 6
  },
  "include": [
    "modules/left.jsonc",
    "modules/center.jsonc",
    "modules/right.jsonc",
    "modules/system.jsonc",
    "modules/custom.jsonc"
  ]
}