{
  "name": "vertical",
  "layer": "top",
  "position": "left",
  "width": 50,
  "spacing": 4,
  "modules-left": [
    "ext/workspaces"
  ],
  "modules-center": [
    "group/center-trio"
  ],
  "modules-right": [
    "group/connections",
    "group/audio",
    "group/hardware",
    "group/power-group",
    "group/sys-status"
  ],
  "group/center-trio": {
    "orientation": "vertical",
    "modules": [
      "custom/hyprsunset",
      "clock",
      "custom/dnd"
    ]
  },
  "group/connections": {
    "orientation": "vertical",
    "modules": [
      "network",
      "bluetooth"
    ]
  },
  "group/audio": {
    "orientation": "vertical",
    "modules": [
      "pulseaudio",
      "pulseaudio#microphone",
      "backlight"
    ]
  },
  "group/hardware": {
    "orientation": "vertical",
    "modules": [
      "cpu",
      "temperature",
      "memory"
    ]
  },
  "group/power-group": {
    "orientation": "vertical",
    "modules": [
      "battery"
    ]
  },
  "group/sys-status": {
    "orientation": "vertical",
    "modules": [
      "idle_inhibitor",
      "tray",
      "custom/power-btn"
    ]
  },
  "custom/hyprsunset": {
    "exec": "~/hypr-dots/scripts/hyprsunset-status.sh",
    "return-type": "json",
    "tooltip": true,
    "align": 0.5,
    "justify": "center",
    "on-click": "~/hypr-dots/scripts/hyprsunset-toggle.sh",
    "signal": 2
  },

  "clock": {
    "interval": 60,
    "tooltip": true,
    "align": 0.5,
    "justify": "center",
    "format": "{:%H\n%M}",
    "tooltip-format": "<span>{:%A, %B %d, %Y}</span>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'><b>{}</b></span>",
        "weeks": "<span color='#a6e3a1'><b>W{}</b></span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    },
    "on-click": "wpaperctl next",
    "on-click-right": "wpaperctl previous"
  },
  "custom/dnd": {
    "exec": "~/hypr-dots/scripts/mako-dnd-status.sh",
    "return-type": "json",
    "format": "{text}",
    "align": 0.5,
    "justify": "center",
    "on-click": "~/hypr-dots/scripts/mako-dnd-toggle.sh",
    "tooltip": true,
    "signal": 3
  },

  "network": {
    "interval": 2,
    "format": "󰈀",
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤮",
    "format-disabled": "󰤮",
    "align": 0.5,
    "justify": "center",
    "tooltip-format-wifi": "󰤨 {essid}\n󰒢 {signalStrength}%\n󰩟 {ipaddr}\n↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "tooltip-format-ethernet": "󰈀 {ifname}\n󰩟 {ipaddr}\n↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Network disconnected",
    "on-click": "kitty -e nmtui"
  },
  "bluetooth": {
    "format": "",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "align": 0.5,
    "justify": "center",
    "tooltip-format": "{controller_alias}\t{status}",
    "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
    "on-click": "blueman-manager"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "{icon}",
    "format-muted": "",
    "align": 0.5,
    "justify": "center",
    "format-icons": {
      "headphone": "",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip": true,
    "tooltip-format": "{desc} | {volume}%"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "",
    "format-source-muted": "",
    "align": 0.5,
    "justify": "center",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.3 @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
    "scroll-step": 5,
    "tooltip": true,
    "tooltip-format": "Microphone: {volume}%"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "",
    "format-full": "󰁹",
    "align": 0.5,
    "justify": "center",
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰂂"
    ],
    "tooltip-format": "{capacity}% ({time})"
  },
  "backlight": {
    "format": "{icon}",
    "align": 0.5,
    "justify": "center",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%"
  },
  "cpu": {
    "interval": 5,
    "format": "",
    "align": 0.5,
    "justify": "center",
    "tooltip": true,
    "tooltip-format": "CPU: {usage}%"
  },
  "temperature": {
    "critical-threshold": 75,
    "hwmon-path-abs": [
      "/sys/devices/platform/coretemp.0/hwmon",
      "/sys/devices/pci0000:00/0000:00:18.3/hwmon"
    ],
    "input-filename": "temp1_input",
    "format": "",
    "format-critical": "🔥",
    "align": 0.5,
    "justify": "center",
    "tooltip": true,
    "tooltip-format": "Temp: {temperatureC}°C"
  },
  "memory": {
    "interval": 10,
    "format": "",
    "align": 0.5,
    "justify": "center",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "align": 0.5,
    "justify": "center",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip-format-activated": "Idle Inhibitor: Active",
    "tooltip-format-deactivated": "Idle Inhibitor: Inactive"
  },
  "custom/power-btn": {
    "format": "",
    "align": 0.5,
    "justify": "center",
    "tooltip-format": "Power menu",
    "on-click": "wlogout"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 6
  },
  "include": [
    "modules/left.jsonc",
    "modules/custom.jsonc"
  ]
}